@{
    ViewData["Title"] = "Sparkle Wash";
}
@if (TempData["Message"] != null)
{
    <div id="success-alert" class="alert alert-success text-center fw-bold fs-5 shadow-sm mt-3 container">
        @TempData["Message"]
    </div>
    <script>
        setTimeout(function() {
            var alertBox = document.getElementById('success-alert');
            if (alertBox) {
                alertBox.style.transition = 'opacity 1s';
                alertBox.style.opacity = '0';
                setTimeout(function() { alertBox.style.display = 'none'; }, 1000);
            }
        }, 4000);
    </script>
}
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Poppins:wght@400;600&display=swap');

    .brand-title {
        font-family: 'Cinzel', serif;
        letter-spacing: 3px;
        font-size: 4rem;
        color: #00e5ff;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.8);
    }

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.8)), url('https://images.unsplash.com/photo-1552930294-6b595f4c2974?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80') no-repeat center center/cover;
        min-height: 550px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-bottom: 5px solid #00e5ff;
    }
</style>

<!-- Hero Section -->
<div class="hero-section text-center text-white shadow-lg rounded">
    <div class="mb-3">
        <img src="https://cdn-icons-png.flaticon.com/512/8204/8204217.png" alt="Logo" width="100" style="filter: drop-shadow(0 0 10px #00e5ff);" />
    </div>
    <h1 class="brand-title">SPARKLE WASH</h1>
    <p class="lead fs-4" style="font-family: 'Poppins', sans-serif;">Premium Car, Bike & MIDC Transport Detailing</p>
    <div class="mt-4">
        <a href="#packages" class="btn btn-lg btn-outline-info px-4 py-3 fw-bold me-2">View Packages</a>
        <a href="#ppf-studio" class="btn btn-lg btn-warning px-4 py-3 fw-bold shadow-lg me-2">🛡️ PPF & Coating</a>
    </div>
</div>

